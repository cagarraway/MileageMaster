# Copy to `.env` for local development. These values match docker-compose.yml.
# In production (Hostinger), set these as environment variables in hPanel instead.
# Separate variables (rather than a single connection URL) mean passwords
# containing characters like % # @ don't need URL-encoding.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mileagemaster
DB_USER=mileagemaster
DB_PASSWORD=mileagemaster
